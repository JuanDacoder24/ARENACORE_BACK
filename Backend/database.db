-- =====================================================
-- 10. INFORMACIÓN DE LA APLICACIÓN
-- =====================================================

CREATE TABLE informacion_app (
    id INT PRIMARY KEY AUTO_INCREMENT,
    clave VARCHAR(100) NOT NULL UNIQUE,
    titulo VARCHAR(200),
    contenido TEXT,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

