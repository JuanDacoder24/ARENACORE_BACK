-- =====================================================
-- VERIFICACIÓN DE DATOS
-- =====================================================
SELECT 'Usuarios insertados:' AS Info, COUNT(*) AS Total FROM usuarios;
SELECT 'Estadísticas creadas:' AS Info, COUNT(*) AS Total FROM estadisticas_jugador;
SELECT 'Billeteras creadas:' AS Info, COUNT(*) AS Total FROM billetera;
SELECT 'Torneos creados:' AS Info, COUNT(*) AS Total FROM torneos;
SELECT 'Inscripciones realizadas:' AS Info, COUNT(*) AS Total FROM inscripciones;
SELECT 'Partidas registradas:' AS Info, COUNT(*) AS Total FROM partidas;