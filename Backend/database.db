-- =====================================================
-- DATOS ADICIONALES ÚTILES PARA PRUEBAS
-- =====================================================

-- Vista de resumen de torneos activos
SELECT 'Inserción completada exitosamente!' AS Status;
SELECT COUNT(*) AS Total_Usuarios FROM usuarios;
SELECT COUNT(*) AS Total_Juegos FROM juegos;
SELECT COUNT(*) AS Total_Torneos FROM torneos;
SELECT COUNT(*) AS Total_Inscripciones FROM inscripciones;
SELECT COUNT(*) AS Total_Partidas FROM partidas;

-- Consulta de ejemplo: Top 5 jugadores por ranking
SELECT u.username, e.nivel, e.ranking_global, e.torneos_ganados 
FROM usuarios u 
JOIN estadisticas_jugador e ON u.id = e.usuario_id 
ORDER BY e.ranking_global ASC 
LIMIT 5;

-- Consulta de ejemplo: Torneos más populares (más inscripciones)
SELECT t.nombre, COUNT(i.id) AS inscripciones, t.premio_total
FROM torneos t
LEFT JOIN inscripciones i ON t.id = i.torneo_id AND i.estado = 'confirmada'
GROUP BY t.id
ORDER BY inscripciones DESC
LIMIT 5;

select * from usuarios;

