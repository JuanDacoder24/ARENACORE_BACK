{
  "name": "arenacore-backend",
  "version": "1.0.0",
  "description": "Backend para plataforma de torneos de videojuegos ArenaCore",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:sync": "ts-node src/scripts/syncDatabase.ts",
    "db:seed": "ts-node src/scripts/seedDatabase.ts"
  },
  "keywords": [
    "esports",
    "torneos",
    "videojuegos",
    "api"
  ],
  "author": "Tu Nombre",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.1",
    "sequelize": "^6.37.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.16",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}