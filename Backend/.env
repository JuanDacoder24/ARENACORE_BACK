# ============ BASE DE DATOS ============
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ARENACORE
DB_USER=root
DB_PASSWORD=

# ============ JWT / AUTENTICACIÓN ============
JWT_SECRET=arenacore_super_secret_key_change_in_production_2024
